@model List<School.Data.Models.Instructor>
@{
    ViewData["Title"] = "Instructors";
}

<h1>Instructors</h1>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Hire Date</th>
        <th>Courses</th>
        <th></th>
    </tr>
    @foreach (var instructor in Model)
    {
        <tr>
            <td>@instructor.FullName</td>
            <td>@instructor.HireDate.ToString("yyyy-MM-dd")</td>
            <td>
                @if (instructor.CourseAssignments?.Any() == true)
                {
                    <ul class="mb-0">
                        @foreach (var assignment in instructor.CourseAssignments)
                        {
                            <li>@assignment.Course?.Title</li>
                        }
                    </ul>
                }
                else
                {
                    <span>No courses</span>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@instructor.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@instructor.Id">Edit</a>
            </td>
        </tr>
    }
</table>