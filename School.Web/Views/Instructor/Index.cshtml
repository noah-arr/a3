@model School.Web.Models.PaginatedList<School.Data.Models.Instructor>
@{
	ViewData["Title"] = "Instructor";
}

<h1>Instructors</h1>

<table class="table">
	<tr>
		<th>Id</th>
		<th>Name</th>
		<th>Hire Date</th>
		<th>Courses Taught</th>
		<th>Edit</th>
	</tr>
	@foreach (var instructor in Model)
	{
		<tr>
			<td>@instructor.Id</td>
			<td>@instructor.FullName</td>
			<td>@instructor.HireDate.ToString("yyyy-MM-dd")</td>
			<td>
				@if (instructor.CourseAssignments.Any())
				{
					<ul>
						@foreach (var a in instructor.CourseAssignments)
						{
							<li>@a.Course.Title</li>
						}
					</ul>
				}
				else
				{
					<span>No Courses</span>
				}
			</td>
			<td>
				<a class="btn btn-primary" asp-action="Edit" asp-route-id="@instructor.Id">Edit</a>
			</td>
		</tr>
	}
</table>

<div>
	<a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)"
	   class="btn btn-outline-primary @(Model.HasPrevPage ? "" : "disabled")">Previous</a>

	<span class="mx-2">Page @Model.PageIndex of @Model.TotalPages</span>

	<a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
	   class="btn btn-outline-primary @(Model.HasNextPage ? "" : "disabled")">Next</a>
</div>