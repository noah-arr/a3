@model School.Web.Models.PaginatedList<School.Data.Models.Course>
@{
	ViewData["Title"] = "Courses";
}

<h1>Courses</h1>

<table class="table">
	<tr>
		<th>Course ID</th>
		<th>Title</th>
		<th>Credits</th>
		<th>Department</th>
		<th>Students Enrolled</th>
		<th>Edit</th>
	</tr>
	@foreach (var course in Model)
	{
		<tr>
			<td>@course.CourseId</td>
			<td>@course.Title</td>
			<td>@course.Credits</td>
			<td>@course.Department?.Name</td>
			<td>
				@if (course.Enrollments.Any())
				{
					<ul>
						@foreach (var e in course.Enrollments)
						{
							<li>@e.Student.FullName</li>
						}
					</ul>
				}
				else
				{
					<span>No Students Enrolled.</span>
				}
			</td>
			<td>
				<a class="btn btn-primary" asp-action="Edit" asp-route-id="@course.CourseId">Edit</a>
			</td>
		</tr>
	}
</table>

<div>
	<a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)"
	   class="btn btn-outline-primary @(Model.HasPrevPage ? "" : "disabled")">Previous</a>

	<span class="mx-2">Page @Model.PageIndex of @Model.TotalPages</span>

	<a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
	   class="btn btn-outline-primary @(Model.HasNextPage ? "" : "disabled")">Next</a>
</div>