@model List<School.Data.Models.Course>
@{
	ViewData["Title"] = "Courses";
}

<h1>Courses</h1>

<table class="table">
	<tr>
		<th>Course ID</th>
		<th>Title</th>
		<th>Credits</th>
		<th>Department</th>
	</tr>
	@foreach (var course in Model)
	{
		<tr>
			<td>@course.CourseId</td>
			<td>@course.Title</td>
			<td>@course.Credits</td>
			<td>@course.Department?.Name</td>
		</tr>
	}
</table>